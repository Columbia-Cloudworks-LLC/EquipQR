{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://equipqr.app/schemas/lint-targets.json",
  "title": "EquipQR lint catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "targets"],
  "properties": {
    "version": { "const": 1 },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/lintTarget" }
    }
  },
  "$defs": {
    "fileMatch": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "never" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "extensions"],
          "properties": {
            "kind": { "const": "when" },
            "extensions": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "excludeSuffixes": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "under": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "hookScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failClosed", "missingTool", "argv", "maxOutputLines"],
      "properties": {
        "failClosed": { "const": true },
        "missingTool": { "enum": ["block", "skip"] },
        "argv": {
          "type": "array",
          "items": { "type": "string" }
        },
        "maxOutputLines": { "type": "integer", "minimum": 1 }
      }
    },
    "outputContract": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "exit-code" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "maxIssues"],
          "properties": {
            "kind": { "const": "fallow-unused" },
            "maxIssues": { "const": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "maxCloneGroups"],
          "properties": {
            "kind": { "const": "fallow-dupes" },
            "maxCloneGroups": { "const": 0 }
          }
        }
      ]
    },
    "batchStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "contract"],
      "properties": {
        "argv": { "type": "array", "items": { "type": "string" } },
        "contract": { "$ref": "#/$defs/outputContract" }
      }
    },
    "lintTarget": {
      "allOf": [
        {
          "type": "object",
          "required": ["id", "kind", "match", "hook", "batch"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "kind": {
              "enum": ["node-cli", "npx", "external-bin", "pwsh-module"]
            },
            "match": { "$ref": "#/$defs/fileMatch" },
            "hook": {
              "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/hookScope" }]
            },
            "batch": {
              "type": "object",
              "additionalProperties": false,
              "required": ["steps"],
              "properties": {
                "steps": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "#/$defs/batchStep" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "match": {
                "properties": { "kind": { "const": "never" } },
                "required": ["kind"]
              }
            },
            "required": ["match"]
          },
          "then": {
            "properties": { "hook": { "type": "null" } }
          }
        },
        {
          "oneOf": [
            {
              "properties": {
                "kind": { "const": "node-cli" },
                "bin": { "type": "string", "minLength": 1 }
              },
              "required": ["kind", "bin"]
            },
            {
              "properties": {
                "kind": { "const": "npx" },
                "package": { "type": "string", "minLength": 1 }
              },
              "required": ["kind", "package"]
            },
            {
              "properties": {
                "kind": { "const": "external-bin" },
                "tool": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "version", "githubRelease"],
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "version": { "type": "string", "minLength": 1 },
                    "githubRelease": { "type": "string", "pattern": "^[^/]+/[^/]+$" }
                  }
                }
              },
              "required": ["kind", "tool"]
            },
            {
              "properties": {
                "kind": { "const": "pwsh-module" },
                "module": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "version"],
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "version": { "type": "string", "minLength": 1 }
                  }
                },
                "function": { "type": "string", "minLength": 1 }
              },
              "required": ["kind", "module", "function"]
            }
          ]
        }
      ]
    }
  }
}
