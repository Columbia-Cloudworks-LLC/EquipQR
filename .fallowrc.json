{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignoreDependencies": [
    "@size-limit/file",
    "tailwindcss-animate",
    "us-atlas"
  ],
  "ignorePatterns": [
    "vitest/**",
    "tmp/**"
  ],
  "ignoreExportsUsedInFile": true,
  "duplicates": {
    "ignore": [
      "src/integrations/supabase/types.ts",
      "src/pages/PrivacyPolicy.tsx",
      "src/pages/TermsOfService.tsx",
      "supabase/functions/**",
      "dev/**",
      "e2e/**/*.ts",
      "src/**/*.test.ts",
      "src/**/*.test.tsx",
      "vitest/**",
      "dev/**/*.test.ts",
      "dev/**/*.test.mjs",
      "e2e/**/*.test.ts",
      "supabase/functions/**/*.test.ts",
      "supabase/functions/**/*.deno.test.ts",
      "supabase/functions/**/*.vitest.test.ts",
      ".github/scripts/**/*.test.js"
    ]
  },
  "entry": [
    "dev/invoice-export-smoke.deno.ts",
    "playwright.user.config.ts",
    "src/sw.ts",
    "dev/check-root-layout.mjs",
    "dev/check-missing-migrations.mjs",
    "dev/reconcile-advisor-rpc-warnings.mjs",
    "dev/supabase-fix-migrations.mjs",
    "dev/test-ci.mjs",
    "dev/test-ci-entry.mjs",
    "dev/test-ci-sharded.mjs",
    "dev/upload-screenshot.ts",
    "dev/dfy/provision-yard.mjs",
    "dev/docs-media/print-storage-path.ts",
    "dev/vitest-perf/publish-duration-pr-comment.mjs",
    "dev/cloud-agent/seed-quick-login.mjs",
    "dev/linux/prereq.mjs",
    "dev/linux/sync-local-supabase-env.mjs",
    "dev/ci/check-github-environment-names.mjs",
    "dev/ci/assert-preview-env-present.sh",
    "dev/linux/stack.mjs",
    "dev/**/*.test.mjs",
    "dev/pr-evidence/reset-fresh-start-onboarding.ts",
    "dev/qbo/qbo-browser-signin.mjs",
    "docs/public/sw.js",
    "playwright.pr-evidence.config.ts",
    "playwright.screen-catalog.config.ts"
  ],
  "ignoreExports": [
    {
      "file": "src/components/ui/**",
      "exports": [
        "*"
      ]
    },
    {
      "file": "src/pages/features/data/*Data.ts",
      "exports": [
        "benefits",
        "capabilities",
        "content",
        "heroIcon",
        "showcases",
        "steps"
      ]
    },
    {
      "file": "src/integrations/supabase/types.ts",
      "exports": [
        "*"
      ]
    }
  ],
  "usedClassMembers": [
    "invalidateOrganizationMemberRelated",
    "invalidateOrganizationInvitationRelated"
  ]
}
