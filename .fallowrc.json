{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignoreDependencies": [
    "size-limit",
    "@size-limit/file",
    "tailwindcss-animate",
    "us-atlas",
    "xlsx"
  ],
  "ignorePatterns": [
    "vitest/**",
    "tmp/**"
  ],
  "ignoreExportsUsedInFile": true,
  "duplicates": {
    "ignore": [
      "src/integrations/supabase/types.ts",
      "src/pages/PrivacyPolicy.tsx",
      "src/pages/TermsOfService.tsx",
      "src/pages/features/**",
      "src/pages/solutions/**",
      "src/components/landing/**",
      "supabase/functions/**",
      "dev/**",
      "e2e/**/*.ts",
      "src/**/*.test.ts",
      "src/**/*.test.tsx",
      "vitest/**",
      "dev/**/*.test.ts",
      "dev/**/*.test.mjs",
      "e2e/**/*.test.ts",
      "supabase/functions/**/*.test.ts",
      "supabase/functions/**/*.deno.test.ts",
      "supabase/functions/**/*.vitest.test.ts",
      ".github/scripts/**/*.test.js"
    ]
  },
  "entry": [
    "dev/invoice-export-smoke.deno.ts",
    "playwright.user.config.ts",
    "src/sw.ts",
    "dev/check-root-layout.mjs",
    "dev/check-main-branch-migrations.mjs",
    "dev/check-missing-migrations.mjs",
    "dev/create-missing-migrations.mjs",
    "dev/fix-main-branch-migrations.mjs",
    "dev/reconcile-advisor-rpc-warnings.mjs",
    "dev/supabase-fix-migrations.mjs",
    "dev/test-ci.mjs",
    "dev/test-ci-entry.mjs",
    "dev/test-ci-sharded.mjs",
    "dev/upload-screenshot.ts",
    "dev/dfy/provision-yard.mjs",
    "dev/docs-media/print-storage-path.ts",
    "dev/run-vitest-local.test.mjs",
    "dev/vitest-perf/report-vitest-durations.test.mjs",
    "dev/vitest-perf/publish-duration-pr-comment.mjs",
    "dev/cloud-agent/seed-quick-login.mjs",
    "dev/linux/prereq.mjs",
    "dev/linux/sync-local-supabase-env.mjs",
    "dev/linux/devcontainer-node-policy.test.mjs",
    "dev/linux/prereq.test.mjs",
    "dev/linux/sync-local-supabase-env.test.mjs",
    "dev/ci/check-github-environment-names.mjs",
    "dev/ci/check-github-environment-names.test.mjs",
    "dev/ci/assert-preview-env-present.sh",
    "dev/linux/stack.mjs"
  ],
  "ignoreExports": [
    {
      "file": "src/components/ui/**",
      "exports": [
        "*"
      ]
    },
    {
      "file": "src/pages/features/data/*Data.ts",
      "exports": [
        "*"
      ]
    },
    {
      "file": "src/features/equipment/types/equipment.ts",
      "exports": [
        "*"
      ]
    },
    {
      "file": "src/features/work-orders/services/workOrderNotesService.ts",
      "exports": [
        "*"
      ]
    },
    {
      "file": "src/utils/google-workspace.ts",
      "exports": [
        "*"
      ]
    },
    {
      "file": "supabase/functions/_shared/work-order-google-docs-single-data.ts",
      "exports": [
        "*"
      ]
    },
    {
      "file": "src/pages/features/data/qrCodeIntegrationData.ts",
      "exports": [
        "*"
      ]
    },
    {
      "file": "src/integrations/supabase/types.ts",
      "exports": [
        "*"
      ]
    },
    {
      "file": "vitest/**",
      "exports": [
        "*"
      ]
    }
  ],
  "usedClassMembers": [
    "clear",
    "updatePayload",
    "getById",
    "retryFailedItems",
    "invalidateOrganizationMemberRelated",
    "invalidateOrganizationInvitationRelated"
  ]
}
