{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "bash .cursor/hooks/workflow.sh sync-types"
      },
      {
        "command": "bash .cursor/hooks/workflow.sh lint-on-edit",
        "failClosed": true
      },
      {
        "command": "bash .cursor/hooks/workflow.sh strict-type-check"
      },
      {
        "command": "bash .cursor/hooks/workflow.sh run-tests"
      },
      {
        "command": "python3 .cursor/hooks/architecture-guard.py"
      }
    ],
    "beforeReadFile": [
      {
        "command": "bash .cursor/hooks/workflow.sh guard-migrations"
      },
      {
        "command": "python3 .cursor/hooks/component-check.py"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "python3 .cursor/hooks/secret-guardian.py"
      },
      {
        "command": "python3 .cursor/hooks/architecture-guard.py"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python3 .cursor/hooks/secret-guardian.py"
      }
    ],
    "stop": [
      {
        "command": "bash .cursor/hooks/workflow.sh changelog-stop",
        "loop_limit": 2
      }
    ]
  }
}
