{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "EquipQR: Dev (Edge)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:8080",
      "webRoot": "${workspaceFolder}",
      "resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"],
      "preLaunchTask": "EquipQR: Start Full Dev Stack",
      "preRestartTask": "EquipQR: Restart Dev Stack"
    },
    {
      "name": "EquipQR: Dev (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8080",
      "webRoot": "${workspaceFolder}",
      "resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"],
      "preLaunchTask": "EquipQR: Start Full Dev Stack",
      "preRestartTask": "EquipQR: Restart Dev Stack"
    }
  ]
}
